# Hosting
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS='https://localhost:7273;http://localhost:5119'
AllowedHosts=*

# Logging
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# CORS
Cors__AllowLocalhost=true
# Cors__AllowedOrigins__0=https://frontend.example.com

# Persistence
ConnectionStrings__StudentManagementDb='Server=(localdb)\mssqllocaldb;Database=StudentManagement;Trusted_Connection=True;TrustServerCertificate=True'

# JWT security
Security__Jwt__Issuer=StudentManagementApi
Security__Jwt__Audience=StudentManagementClient
Security__Jwt__SigningKey=replace-with-a-random-secret-containing-at-least-32-characters
Security__Jwt__AccessTokenLifetimeMinutes=15
