  <diagram id="request-flow" name="03 - Flujo y seguridad">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-title" value="Student Management — Flujo de una solicitud y controles" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="930" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3-subtitle" value="Un dominio público; CloudFront decide si responde el frontend o envía la solicitud a la API" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#5F6B7A;" vertex="1" parent="1">
          <mxGeometry x="42" y="70" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p3-public" value="Internet y capa pública" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8C4FFF;strokeWidth=2;fillColor=#F5EFFF;verticalAlign=top;align=left;spacingTop=10;spacingLeft=12;fontSize=16;fontStyle=1;fontColor=#442266;" vertex="1" parent="1">
          <mxGeometry x="35" y="125" width="600" height="530" as="geometry" />
        </mxCell>
        <mxCell id="p3-aws-private" value="Región AWS · us-east-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="660" y="125" width="1000" height="530" as="geometry" />
        </mxCell>
        <mxCell id="p3-vpc" value="VPC · 10.42.0.0/16" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;strokeWidth=2;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="980" y="190" width="380" height="415" as="geometry" />
        </mxCell>
        <mxCell id="p3-vpc-note" value="VPC attachment · subredes privadas A + B" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#8C4FFF;" vertex="1" parent="1">
          <mxGeometry x="1010" y="215" width="320" height="25" as="geometry" />
        </mxCell>

        <mxCell id="p3-browser" value="&lt;b&gt;1. Navegador&lt;/b&gt;&lt;br&gt;Angular SPA&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;HTTPS + cookies seguras&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#545B64;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="75" y="275" width="175" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3-cloudfront" value="&lt;b&gt;2. CloudFront&lt;/b&gt;&lt;br&gt;Termina HTTPS&lt;br&gt;y enruta por path" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#8C4FFF;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="315" y="275" width="190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p3-s3" value="&lt;b&gt;3A. S3 privado&lt;/b&gt;&lt;br&gt;index.html + assets&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Acceso solo mediante OAC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#3F8624;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="390" y="465" width="205" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-route" value="&lt;b&gt;Decisión por ruta&lt;/b&gt;&lt;br&gt;/ y assets → S3&lt;br&gt;/api/* → API Gateway&lt;br&gt;/swagger* → API Gateway" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B8A2D9;fillColor=#FFFFFF;fontColor=#442266;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="450" width="245" height="130" as="geometry" />
        </mxCell>

        <mxCell id="p3-apigw" value="&lt;b&gt;3B. API Gateway REST&lt;/b&gt;&lt;br&gt;ANY /{proxy+}&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AWS_PROXY · sin caché API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#8C4FFF;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="710" y="270" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-lambda" value="&lt;b&gt;4. AWS Lambda&lt;/b&gt;&lt;br&gt;.NET 10 Minimal API&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Autenticación · roles · CSRF&lt;br&gt;Aplicación + dominio + infraestructura&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1030" y="260" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p3-secret" value="&lt;b&gt;5A. Secrets Manager&lt;/b&gt;&lt;br&gt;Connection string&lt;br&gt;JWT + bootstrap admin&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;VPC Endpoint · TCP 443&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#DD344C;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1390" y="235" width="235" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-rds" value="&lt;b&gt;5B. RDS SQL Server&lt;/b&gt;&lt;br&gt;Datos académicos&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Privado · SG Lambda · TCP 1433&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#3B48CC;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1030" y="455" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-logs" value="&lt;b&gt;5C. CloudWatch Logs&lt;/b&gt;&lt;br&gt;Invocaciones, tiempos y errores" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#E7157B;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1390" y="450" width="235" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-cold-start" value="&lt;b&gt;En un cold start de Development&lt;/b&gt;&lt;br&gt;La función obtiene la configuración, aplica migraciones pendientes si están habilitadas y garantiza el administrador inicial de forma idempotente." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D68A00;fillColor=#FFF4D6;fontColor=#6B4700;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="465" width="245" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p3-controls" value="Defensa por capas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="45" y="700" width="280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3-control-edge" value="&lt;b&gt;Entrada pública controlada&lt;/b&gt;&lt;br&gt;CloudFront es el único dominio visible. Fuerza HTTPS y separa frontend de API por rutas." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B8A2D9;fillColor=#F5EFFF;fontColor=#442266;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="45" y="755" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3-control-network" value="&lt;b&gt;Red y datos privados&lt;/b&gt;&lt;br&gt;RDS no tiene IP pública. Su Security Group solo admite SQL Server desde el Security Group de Lambda." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#59A14F;fillColor=#EAF6F0;fontColor=#145A0B;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="755" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3-control-secrets" value="&lt;b&gt;Secretos fuera del código&lt;/b&gt;&lt;br&gt;Terraform genera credenciales y claves aleatorias; Lambda las consulta con IAM mínimo mediante un endpoint privado." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E5A3AE;fillColor=#FDECEF;fontColor=#8A1F32;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="835" y="755" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3-control-app" value="&lt;b&gt;Seguridad de aplicación&lt;/b&gt;&lt;br&gt;ASP.NET Core valida identidad, estado de cuenta, roles y antiforgery antes de ejecutar los casos de uso." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#AAB2BD;fillColor=#F7F8FA;fontColor=#344054;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="755" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3-return" value="La respuesta regresa por el mismo camino: RDS → Lambda → API Gateway → CloudFront → navegador." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0969DA;strokeWidth=2;fillColor=#DDF4FF;fontColor=#0550AE;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="395" y="955" width="910" height="65" as="geometry" />
        </mxCell>

        <mxCell id="p3-e-browser-cf" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A2CA0;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p3-browser" target="p3-cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e-cf-route" value="Path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5A2CA0;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p3-cloudfront" target="p3-route">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e-route-s3" value="SPA / assets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3F8624;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p3-route" target="p3-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e-cf-api" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p3-cloudfront" target="p3-apigw">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="590" y="325" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3-e-api-lambda" value="Evento proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B56A00;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p3-apigw" target="p3-lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e-lambda-secret" value="GetSecretValue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p3-lambda" target="p3-secret">
