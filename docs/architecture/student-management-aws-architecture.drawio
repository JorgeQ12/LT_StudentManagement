        <mxCell id="p2-e-init-apply" value="Solo backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8C4FFF;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="p2-init" target="p2-apply">
