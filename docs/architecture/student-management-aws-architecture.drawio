          <mxGeometry x="545" y="500" width="1065" height="390" as="geometry" />
        </mxCell>
        <mxCell id="p2-init" value="&lt;b&gt;2. terraform init&lt;/b&gt;&lt;br&gt;Siempre lee el estado S3&lt;br&gt;y adquiere el lock" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5A2CA0;strokeWidth=2;fillColor=#FFFFFF;fontColor=#442266;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="585" y="575" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-apply" value="&lt;b&gt;3A. terraform apply&lt;/b&gt;&lt;br&gt;Solo para backend o IaC&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Actualiza Lambda y recursos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5A2CA0;strokeWidth=2;fillColor=#8C4FFF;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="825" y="575" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-resources" value="&lt;b&gt;Grafo de recursos AWS&lt;/b&gt;&lt;br&gt;VPC · Subredes · SG · RDS&lt;br&gt;Secrets · Lambda · API Gateway&lt;br&gt;S3 · CloudFront · IAM" style="rounded=1;whiteSpace=wrap;html=1;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;align=left;spacingLeft=52;strokeColor=#232F3E;strokeWidth=2;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="555" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p2-initdb" value="&lt;b&gt;4A. Verificar API&lt;/b&gt;&lt;br&gt;Solo para backend&lt;br&gt;Migrations + administrador&lt;br&gt;Reintentos hasta HTTP 200" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#B56A00;strokeWidth=2;fillColor=#FFF4D6;fontColor=#6B4700;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="675" y="735" width="245" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p2-publish" value="&lt;b&gt;3B. Publicar frontend&lt;/b&gt;&lt;br&gt;Solo para cambios Web&lt;br&gt;S3 sync --delete&lt;br&gt;Invalidación CloudFront" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#256D1B;strokeWidth=2;fillColor=#ECF8E8;fontColor=#225A19;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="955" y="735" width="235" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p2-summary" value="&lt;b&gt;4B. Resumen del job&lt;/b&gt;&lt;br&gt;Alcance desplegado&lt;br&gt;URL frontend · Swagger" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0969DA;strokeWidth=2;fillColor=#DDF4FF;fontColor=#0550AE;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1225" y="735" width="205" height="115" as="geometry" />
        </mxCell>

        <mxCell id="p2-layout" value="&lt;b&gt;Estructura de IaC&lt;/b&gt;&lt;br&gt;&lt;br&gt;infrastructure/terraform/&lt;br&gt;├─ bootstrap/&lt;br&gt;│  └─ estado + OIDC + rol&lt;br&gt;└─ development/&lt;br&gt;   └─ infraestructura completa&lt;br&gt;&lt;br&gt;&lt;b&gt;Principio:&lt;/b&gt; configuración declarativa, dependencias inferidas por referencias y estado remoto compartido." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#AAB2BD;fillColor=#FFFFFF;fontColor=#344054;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="720" width="390" height="230" as="geometry" />
        </mxCell>

